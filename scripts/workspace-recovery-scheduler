#!/usr/bin/env bash
# Install an opt-in user scheduler for tmux-resurrect snapshots.

set -euo pipefail
umask 077
shopt -u patsub_replacement 2>/dev/null || true

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
TEMPLATE_DIR="$ROOT_DIR/contrib"
LIFECYCLE="$SCRIPT_DIR/session-lifecycle"
LABEL=com.atlascrew.tmux-workspace-recovery.save
SYSTEMD_UNIT=tmux-workspace-recovery-save
INTERVAL=600
NO_ENABLE=0

usage() {
  cat <<'USAGE'
Usage:
  workspace-recovery-scheduler install [--interval SECONDS] [--no-enable]
  workspace-recovery-scheduler status
  workspace-recovery-scheduler uninstall
  workspace-recovery-scheduler cron [--interval SECONDS]

Install enables a per-user launchd job on macOS or systemd timer on Linux.
Cron prints an entry for manual installation and never changes the crontab.
USAGE
}

die() {
  printf 'workspace-recovery-scheduler: %s\n' "$1" >&2
  exit 1
}

validate_interval() {
  [[ $INTERVAL =~ ^[0-9]+$ ]] || die "interval must be an integer number of seconds"
  (( INTERVAL >= 60 && INTERVAL <= 86400 )) ||
    die "interval must be between 60 and 86400 seconds"
}

require_single_line() {
  [[ $1 != *$'\n'* && $1 != *$'\r'* ]] || die "$2 contains a newline"
}

xml_escape() {
  local value=$1
  value=${value//&/&amp;}
  value=${value//</&lt;}
  value=${value//>/&gt;}
  printf '%s' "$value"
}

systemd_escape() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//%/%%}
  printf '%s' "$value"
}

render_template() {
  local source=$1
  local destination=$2
  shift 2
  local content token replacement temporary

  [[ -r $source ]] || die "template is unavailable: $source"
  (( $# % 2 == 0 )) || die "internal template replacement error"
  content=$(<"$source")
  while (( $# > 0 )); do
    token=$1
    replacement=$2
    content=${content//$token/$replacement}
    shift 2
  done
  [[ ! $content =~ __[A-Z_]+__ ]] || die "template contains an unresolved placeholder: $source"

  mkdir -p "$(dirname "$destination")"
  if [[ -e $destination ]] &&
      ! grep -Fq 'Generated by tmux-workspace-recovery' "$destination"; then
    die "refusing to replace unmanaged file: $destination"
  fi
  temporary=$(mktemp "$(dirname "$destination")/.tmux-workspace-recovery.XXXXXX")
  printf '%s\n' "$content" >"$temporary"
  chmod 600 "$temporary"
  mv -f -- "$temporary" "$destination"
}

require_managed_or_absent() {
  local path=$1
  if [[ -e $path ]] && ! grep -Fq 'Generated by tmux-workspace-recovery' "$path"; then
    die "refusing to remove unmanaged file: $path"
  fi
}

resolved_tmux() {
  local candidate=${TMUX_BIN:-}
  if [[ -z $candidate ]]; then
    candidate=$(command -v tmux 2>/dev/null || true)
  fi
  [[ -n $candidate && -x $candidate ]] || die "tmux is not executable; set TMUX_BIN"
  require_single_line "$candidate" "tmux path"
  printf '%s\n' "$candidate"
}

platform_name() {
  uname -s
}

launchd_path() {
  printf '%s/Library/LaunchAgents/%s.plist\n' "$HOME" "$LABEL"
}

systemd_dir() {
  printf '%s/systemd/user\n' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

install_launchd() {
  local destination tmux_path max_age log_dir domain
  destination=$(launchd_path)
  tmux_path=$(resolved_tmux)
  max_age=$((INTERVAL * 2))
  log_dir=${XDG_STATE_HOME:-$HOME/.local/state}/tmux-workspace-recovery
  domain=gui/$(id -u)
  command -v python3 >/dev/null 2>&1 || die "python3 is required to validate the LaunchAgent"
  if (( ! NO_ENABLE )); then
    command -v launchctl >/dev/null 2>&1 || die "launchctl is unavailable"
  fi
  mkdir -p "$log_dir"
  chmod 700 "$log_dir"

  render_template "$TEMPLATE_DIR/launchd/$LABEL.plist.in" "$destination" \
    __LIFECYCLE__ "$(xml_escape "$LIFECYCLE")" \
    __PATH__ "$(xml_escape "$PATH")" \
    __TMUX_BIN__ "$(xml_escape "$tmux_path")" \
    __MAX_AGE__ "$max_age" \
    __INTERVAL__ "$INTERVAL" \
    __STDOUT__ "$(xml_escape "$log_dir/scheduler.out.log")" \
    __STDERR__ "$(xml_escape "$log_dir/scheduler.err.log")"
  python3 -c 'import plistlib, sys; plistlib.load(open(sys.argv[1], "rb"))' \
    "$destination" || die "generated LaunchAgent is invalid"

  if (( ! NO_ENABLE )); then
    launchctl bootout "$domain/$LABEL" >/dev/null 2>&1 || true
    launchctl bootstrap "$domain" "$destination"
    launchctl kickstart -k "$domain/$LABEL"
  fi
  printf 'Installed launchd scheduler: %s\n' "$destination"
}

install_systemd() {
  local directory service timer tmux_path max_age
  directory=$(systemd_dir)
  service=$directory/$SYSTEMD_UNIT.service
  timer=$directory/$SYSTEMD_UNIT.timer
  tmux_path=$(resolved_tmux)
  max_age=$((INTERVAL * 2))

  if (( ! NO_ENABLE )); then
    command -v systemctl >/dev/null 2>&1 ||
      die "systemctl is unavailable; use the documented cron fallback"
    systemctl --user show-environment >/dev/null ||
      die "systemd user manager is unavailable; use the documented cron fallback"
  fi
  require_managed_or_absent "$service"
  require_managed_or_absent "$timer"

  render_template "$TEMPLATE_DIR/systemd/$SYSTEMD_UNIT.service.in" "$service" \
    __LIFECYCLE__ "$(systemd_escape "$LIFECYCLE")" \
    __PATH__ "$(systemd_escape "$PATH")" \
    __TMUX_BIN__ "$(systemd_escape "$tmux_path")" \
    __MAX_AGE__ "$max_age"
  render_template "$TEMPLATE_DIR/systemd/$SYSTEMD_UNIT.timer.in" "$timer" \
    __INTERVAL__ "$INTERVAL"
  chmod 644 "$service" "$timer"

  if (( ! NO_ENABLE )); then
    systemctl --user daemon-reload
    systemctl --user enable --now "$SYSTEMD_UNIT.timer"
  fi
  printf 'Installed systemd user scheduler: %s\n' "$timer"
}

install_scheduler() {
  [[ -x $LIFECYCLE ]] || die "session lifecycle command is not executable"
  require_single_line "$LIFECYCLE" "plugin path"
  require_single_line "$PATH" "PATH"
  validate_interval
  case $(platform_name) in
    Darwin) install_launchd ;;
    Linux) install_systemd ;;
    *) die "automatic scheduling is supported on macOS and Linux" ;;
  esac
}

scheduler_status() {
  local domain
  case $(platform_name) in
    Darwin)
      [[ -f $(launchd_path) ]] || die "launchd scheduler is not installed"
      command -v launchctl >/dev/null 2>&1 || die "launchctl is unavailable"
      domain=gui/$(id -u)
      launchctl print "$domain/$LABEL"
      ;;
    Linux)
      [[ -f $(systemd_dir)/$SYSTEMD_UNIT.timer ]] || die "systemd timer is not installed"
      command -v systemctl >/dev/null 2>&1 || die "systemctl is unavailable"
      systemctl --user status "$SYSTEMD_UNIT.timer"
      ;;
    *) die "automatic scheduling is supported on macOS and Linux" ;;
  esac
}

uninstall_scheduler() {
  local destination directory domain
  case $(platform_name) in
    Darwin)
      destination=$(launchd_path)
      require_managed_or_absent "$destination"
      domain=gui/$(id -u)
      if command -v launchctl >/dev/null 2>&1; then
        launchctl bootout "$domain/$LABEL" >/dev/null 2>&1 || true
      fi
      rm -f -- "$destination"
      printf 'Removed launchd scheduler: %s\n' "$destination"
      ;;
    Linux)
      directory=$(systemd_dir)
      require_managed_or_absent "$directory/$SYSTEMD_UNIT.service"
      require_managed_or_absent "$directory/$SYSTEMD_UNIT.timer"
      if command -v systemctl >/dev/null 2>&1; then
        systemctl --user disable --now "$SYSTEMD_UNIT.timer" >/dev/null 2>&1 || true
      fi
      rm -f -- "$directory/$SYSTEMD_UNIT.service" "$directory/$SYSTEMD_UNIT.timer"
      if command -v systemctl >/dev/null 2>&1; then
        systemctl --user daemon-reload
      fi
      printf 'Removed systemd user scheduler: %s\n' "$directory/$SYSTEMD_UNIT.timer"
      ;;
    *) die "automatic scheduling is supported on macOS and Linux" ;;
  esac
}

print_cron() {
  local minutes schedule tmux_path max_age
  validate_interval
  (( INTERVAL % 60 == 0 )) || die "cron interval must be a whole number of minutes"
  minutes=$((INTERVAL / 60))
  (( minutes >= 1 && minutes <= 59 )) ||
    die "cron fallback supports intervals from 1 to 59 minutes"
  tmux_path=$(resolved_tmux)
  max_age=$((INTERVAL * 2))
  printf -v schedule '*/%s * * * *' "$minutes"
  printf '%s TMUX_BIN=%q TMUX_SAVE_MAX_AGE_SECONDS=%s %q save >/dev/null 2>&1\n' \
    "$schedule" "$tmux_path" "$max_age" "$LIFECYCLE"
}

command_name=${1:-}
[[ -n $command_name ]] || { usage >&2; exit 2; }
shift
while (( $# > 0 )); do
  case $1 in
    --interval)
      (( $# >= 2 )) || die "--interval requires seconds"
      INTERVAL=$2
      shift 2
      ;;
    --no-enable)
      NO_ENABLE=1
      shift
      ;;
    *) die "unknown option: $1" ;;
  esac
done

case $command_name in
  install) install_scheduler ;;
  status)
    (( INTERVAL == 600 && NO_ENABLE == 0 )) || die "status accepts no options"
    scheduler_status
    ;;
  uninstall)
    (( INTERVAL == 600 && NO_ENABLE == 0 )) || die "uninstall accepts no options"
    uninstall_scheduler
    ;;
  cron)
    (( NO_ENABLE == 0 )) || die "cron does not accept --no-enable"
    print_cron
    ;;
  *) usage >&2; exit 2 ;;
esac
