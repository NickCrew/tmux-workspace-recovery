# Generated by tmux-workspace-recovery. Reinstall instead of editing this file.
[Unit]
Description=Save tmux sessions through tmux-resurrect
Documentation=https://github.com/NickCrew/tmux-plugins/tmux-workspace-recovery

[Service]
Type=oneshot
Environment="PATH=__PATH__"
Environment="TMUX_BIN=__TMUX_BIN__"
Environment="TMUX_SAVE_MAX_AGE_SECONDS=__MAX_AGE__"
ExecStart="__LIFECYCLE__" save
